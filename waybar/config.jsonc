{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 5,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 6,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "battery",
    "custom/ip",
    "custom/kb",
    "custom/containers",
    "tray"
  ],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "on-click": "activate",
    "format": "{name}"
  },

  "clock": {
    "format": "  {:%Y-%m-%d %H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "pulseaudio": {
    "format": "{volume}% ",
    "format-muted": "muted ",
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "format": "{capacity}% {icon}",
    "format-charging": "⚡ {capacity}% {icon}",
    "format-plugged": "⚡ {capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip": true,
    "tooltip-format": "Battery: {capacity}%\nTime: {time}"
  },

  "custom/ip": {
    "exec": "~/.config/waybar/scripts/ip.sh",
    "interval": 10,
    "return-type": "text"
  },

  "custom/kb": {
    "exec": "~/.config/waybar/scripts/kblayout.sh",
    "interval": 1,
    "return-type": "text"
  },

  "custom/containers": {
    "exec": "~/.config/waybar/scripts/docker.sh",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "Contenedores activos: {output}",
    "return-type": "text"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
