/* Global font */
* {
    font-family: Hack Nerd Font, JetBrainsMono Nerd Font, monospace;
    font-size: 12px;
}

/* Main bar background */
window#waybar {
    background: rgba(30, 30, 46, 0.7);
    color: #cdd6f4;
    border-bottom: 1px solid rgba(205, 214, 244, 0.1);
}

/* Workspaces */
#workspaces button {
  padding: 2px 6px;
  border-radius: 6px;
  background: transparent;
  color: #cdd6f4;
}

#workspaces button.focused {
  background: #313244;
}

/* Global padding for right modules */
#pulseaudio,
#battery,
#custom-ip,
#keyboard-state,
#custom-containers,
#clock,
#tray {
    padding: 0 10px;
}

/* Battery states */
#battery.critical {
  color: #f38ba8;
}

#battery.warning {
  color: #fab387;
}

#battery.good {
  color: #a6e3a1;
}

/* IP module */
#custom-ip {
  color: #a6e3a1;
  font-weight: bold;
}

/* Keyboard layout */
#keyboard-state {
  color: #89b4fa;
  font-weight: bold;
}

/* Docker containers */
#custom-containers {
  color: #f38ba8;
  font-weight: bold;
}
