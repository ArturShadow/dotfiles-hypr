[global]
    monitor = 0
    follow = keyboard

    width = (0, 360)
    height = (0, 140)

    origin = top-right
    offset = (20,20)
    scale = 0

    # Apariencia
    transparency = 0
    frame_width = 2
    frame_color = "#8B5CF6"
    separator_color = frame

    font = "Hack Nerd Font 12"
    line_height = 4
    corner_radius = 12
    padding = 12
    horizontal_padding = 12

    # Colores base
    background = "#0A0A12"
    foreground = "#ECECFF"

    # Iconos
    icon_position = left
    max_icon_size = 48
    icon_path = /usr/share/icons/hicolor/48x48/status:/usr/share/icons

    # Tiempo de vida
    idle_threshold = 120
    timeout = 6
    show_age_threshold = 60

    # Historial
    history_length = 20

    # Formato de notificación
    format = "<b>%s</b>\n%b"

    # Barra de progreso
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300


[urgency_low]
    background = "#14142B"
    foreground = "#B4B4E0"
    frame_color = "#2A2A40"
    timeout = 4


[urgency_normal]
    background = "#0A0A12"
    foreground = "#ECECFF"
    frame_color = "#8B5CF6"
    timeout = 6


[urgency_critical]
    background = "#0A0A12"
    foreground = "#ECECFF"
    frame_color = "#EF4444"
    timeout = 0
