# =========================================
# Ignore everything by default
# =========================================

*

# =========================================
# Allow folders/files for dotfiles
# =========================================

!.gitignore
!README.md

!hypr/
!waybar/
!kitty/
!nvim/
!dunst/
!wofi/
!btop/
!gtk-3.0/
!Thunar/
!yazi/
!swaylock/
!wlogout/
!bluetuith/
!xsettingsd/
!lightdm/
!mopidy/

# =========================================
# Allow common config file types
# =========================================

!*/
!**/*.conf
!**/*.config
!**/*.css
!**/*.json
!**/*.jsonc
!**/*.ini
!**/*.toml
!**/*.yaml
!**/*.yml
!**/*.sh
!**/*.zsh
!**/*.txt
!**/*.md
!**/*.service
!**/*.rules

# =========================================
# Secrets / sensitive data
# =========================================

**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.db
**/*token*
**/*secret*
**/*cookie*
**/*session*
**/*.kdbx

# =========================================
# Git repositories inside repo
# =========================================

**/.git/

# =========================================
# Cache / temporary files
# =========================================

.cache/
*.cache
*.log
*.tmp
*.bak
*.old
*.swp
*.swo

# =========================================
# Browsers
# =========================================

BraveSoftware/
google-chrome/
opera/

# =========================================
# VSCode
# =========================================

Code/

# =========================================
# Electron / Chromium apps
# =========================================

Electron/
discord/
Notion/
marktext/
CurseForge/
ow-electron/
configstore/
heroic/

# =========================================
# KDE / Plasma machine-specific
# =========================================

KDE/
kwinoutputconfig.json
kscreenlockerrc
powermanagementprofilesrc
powerdevilrc
kactivitymanagerd-statsrc
plasma-nm/
session/

# =========================================
# Qt runtime configs
# =========================================

QtProject.conf
Trolltech.conf

# =========================================
# Runtime / low-value configs
# =========================================

galculator/
go/
elecwhat/
pavucontrol.ini
yay/
libreoffice/
libreoffice.bak/
pulse/
dconf/user

# =========================================
# Accounts / credentials
# =========================================

ngrok/
kdeconnect/
libaccounts-glib/
signond/
authpass/
remmina/

# =========================================
# KeepassXC
# =========================================

keepassxc/*
!keepassxc/keepassxc.ini

# =========================================
# Obsidian runtime/cache
# =========================================

obsidian/workspace.json
obsidian/*.db
obsidian/Cache/

# =========================================
# Temp/manual files
# =========================================

git-status.txt